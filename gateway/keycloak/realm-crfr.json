{
  "realm": "crfr",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "groups": [
    {
      "name": "claude-users"
    },
    {
      "name": "claude-power-users"
    },
    {
      "name": "team-risk"
    },
    {
      "name": "team-claims"
    },
    {
      "name": "team-redteam"
    }
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-only-not-a-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-claude-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "claude-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "budget-demo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-only-not-a-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-claude-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "claude-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
      "groups": [
        "claude-users",
        "claude-power-users",
        "team-risk"
      ]
    },
    {
      "username": "mallory",
      "enabled": true,
      "email": "mallory@example.org",
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
      "groups": []
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.org",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ],
